# =============================================================================
# Citizen Portal — API configuration (read this before changing .NET)
# =============================================================================
#
# Your Python AI works at:  POST http://localhost:8000/chat
#                           body: { "message": "who is DG" }
#                           response: { "response": "..." }
#
# The React app must reach that contract either:
#   A) Dev (recommended): Vite proxy below — no .NET needed for AI chat
#   B) Production: Browser → .NET /api/ai/chat → Python :8000
#      .NET must forward { message }, NOT { messages: [...] }
#      See bot_api_service PythonAiChatClient.cs (CHATBOT repo) for the fix.
#
# =============================================================================

# --- A) Development: Vite proxy (leave base empty, restart npm run dev) ---
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5165
VITE_API_AI_PROXY_TARGET=http://localhost:8000

# --- B) Direct .NET (only if CORS allows http://localhost:5173) ---
# VITE_API_BASE_URL=http://localhost:5165

VITE_API_SERVICE_STATUS_PATH=/api/service/status
VITE_API_AI_CHAT_PATH=/api/ai/chat
